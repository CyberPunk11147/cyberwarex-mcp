{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.CyberPunk11147/cyberwarex-voice-stt",
  "description": "Speech-to-text transcription for AI agents.",
  "version": "1.0.0",
  "repository": {
    "url": "https://github.com/CyberPunk11147/cyberwarex-mcp",
    "source": "github",
    "subfolder": "voice-stt"
  },
  "websiteUrl": "https://cyberwarex.com",
  "packages": [
    {
      "registryType": "oci",
      "identifier": "ghcr.io/cyberpunk11147/cyberwarex-voice-stt:1.0.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "VOICE_X_PAYMENT",
          "description": "Optional x402 X-PAYMENT header. If unset, the server surfaces the 402 invoice to the agent so its own x402 client can pay and retry.",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "VOICE_BASE_URL",
          "description": "Override the default service URL (https://voice.cyberwarex.com).",
          "isRequired": false
        }
      ]
    }
  ]
}
